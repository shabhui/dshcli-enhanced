<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/paseo_dsha_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/paseo_dsha_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paseo_dsha_card" />
            <corners android:radius="@dimen/paseo_dsha_radius_pill" />
            <stroke
                android:width="@dimen/paseo_dsha_stroke"
                android:color="@color/paseo_dsha_line" />
        </shape>
    </item>
</ripple>
